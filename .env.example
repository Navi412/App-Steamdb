# Clave de la Steam Web API: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# SteamID64 de la cuenta a sincronizar
STEAM_ID=

# Credenciales de IGDB (api.igdb.com) para buscar el tiempo estimado para
# completar cada juego. Requiere una cuenta de Twitch y una app registrada
# en https://dev.twitch.tv/console/apps — el Client ID y Client Secret de
# esa app son estos dos valores.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Puerto del servidor local (opcional)
PORT=3000
