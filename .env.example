# La forma cómoda de rellenar este fichero es:  npm run setup
# (asistente interactivo que explica de dónde sale cada clave, la valida
# contra su API y escribe el .env por ti). Editarlo a mano también vale.
# Repasar el estado en cualquier momento:  npm run setup:check

# Clave de la Steam Web API (obligatoria). Se registra en
# https://steamcommunity.com/dev/apikey con la sesión de Steam iniciada;
# como dominio sirve cualquier cosa (p. ej. localhost).
STEAM_API_KEY=

# SteamID64 (17 dígitos) de la cuenta a sincronizar. El asistente también
# acepta la URL del perfil o el nombre personalizado y lo resuelve. El
# perfil y "Detalles del juego" deben estar públicos en Steam.
STEAM_ID=

# Credenciales de IGDB (api.igdb.com) para buscar el tiempo estimado para
# completar cada juego. Requiere una cuenta de Twitch y una app registrada
# en https://dev.twitch.tv/console/apps — el Client ID y Client Secret de
# esa app son estos dos valores. Opcional.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# OpenXBL (xbl.io): puente con Xbox Live para traer juegos y horas de
# Game Pass / Xbox. La key se saca del perfil en https://xbl.io tras
# iniciar sesión con la cuenta de Microsoft. Opcional.
OPENXBL_API_KEY=

# Epic Games no se configura aquí: su sesión vive en data/epic_auth.json.
# La crea "npm run setup" (o  npm run epic:login <código>).

# Puerto del servidor local (opcional)
PORT=3000
